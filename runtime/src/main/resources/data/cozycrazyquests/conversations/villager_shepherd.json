{"title":"Shepherd","starting_index":0,"dialogues":[{"dialogue_options":[{"dialogue":"Flocks are creatures of habit. When every animal avoids the same patch of grass, I pay attention.","condition":"*","closable":"always","timings":[0.12,0.035,0.28,0.48],"replies":[{"reply":"What do you notice?","action":{"action":"dialogue.goto(1)"}},{"reply":"Anyone need help?","action":[{"action":"give.item(1,cozycrazyquests:conversation_token{ccc_action:\"route_help\"})"},{"action":"dialogue.close"}]},{"reply":"Show me your trades.","action":{"action":"villager.trade"}},{"reply":"I’ll let you work.","action":{"action":"dialogue.close"}}]}]},{"dialogue_options":[{"dialogue":"I know pasture routes, weather exposure, and where the herd should be. Tracks beyond that are the fletcher’s work.","condition":"*","closable":"always","timings":[0.12,0.035,0.28,0.48],"replies":[{"reply":"Anyone need help?","action":[{"action":"give.item(1,cozycrazyquests:conversation_token{ccc_action:\"route_help\"})"},{"action":"dialogue.close"}]},{"reply":"Show me your trades.","action":{"action":"villager.trade"}},{"reply":"Thanks.","action":{"action":"dialogue.close"}}]}]}]}
