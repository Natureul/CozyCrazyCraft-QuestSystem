{"title":"Librarian","starting_index":0,"dialogues":[{"dialogue_options":[{"dialogue":"People bring me legends when what I need is a date, a name, and preferably a page that is not on fire.","condition":"*","closable":"always","timings":[0.12,0.035,0.28,0.48],"replies":[{"reply":"What tells you something is wrong?","action":{"action":"dialogue.goto(1)"}},{"reply":"Anyone need help?","action":[{"action":"give.item(1,cozycrazyquests:conversation_token{ccc_action:\"route_help\"})"},{"action":"dialogue.close"}]},{"reply":"Show me your trades.","action":{"action":"villager.trade"}},{"reply":"Fair enough.","action":{"action":"dialogue.close"}}]}]},{"dialogue_options":[{"dialogue":"If you were there yourself, your report outranks a century-old travel diary. Please be less poetic than the diary.","condition":"*","closable":"always","timings":[0.12,0.035,0.28,0.48],"replies":[{"reply":"Anyone need help?","action":[{"action":"give.item(1,cozycrazyquests:conversation_token{ccc_action:\"route_help\"})"},{"action":"dialogue.close"}]},{"reply":"Show me your trades.","action":{"action":"villager.trade"}},{"reply":"Thanks.","action":{"action":"dialogue.close"}}]}]}]}
