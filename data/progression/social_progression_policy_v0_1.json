      {
        "id": "practical_profession",
        "category": "PROFESSION",
        "preferred_roles": ["weaponsmith", "toolsmith", "armorer", "fletcher", "leatherworker", "butcher"],
        "themes": ["field_test", "equipment", "craft", "supply_chain", "defense"]
      },
      {
        "id": "discovery_investigation",
        "category": "EXPLORATION",
        "preferred_roles": ["cartographer", "librarian", "mason", "cleric"],
        "themes": ["named_place", "survey", "ruin", "record", "route", "relic"]
